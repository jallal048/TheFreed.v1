# Base de datos
DATABASE_URL="file:./dev.db"

# Para producción con PostgreSQL:
# DATABASE_URL="postgresql://username:password@localhost:5432/thefreed_db"

# JWT para autenticación
JWT_SECRET="tu_jwt_secret_muy_seguro_aqui"
JWT_EXPIRES_IN="7d"

# Gemini AI (ya configurado)
GEMINI_API_KEY="your_gemini_api_key_here"

# Stripe para pagos (cuando implementes pagos reales)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Subida de archivos (Cloudinary, S3, etc.)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Email (SendGrid, Mailgun, etc.)
SENDGRID_API_KEY="SG.xxx"
FROM_EMAIL="noreply@thefreed.com"

# Redis para cache (opcional)
REDIS_URL="redis://localhost:6379"

# Configuración del servidor
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Para producción
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3001"