generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  username             String    @unique
  role                 UserRole  @default(FAN)
  avatarUrl            String?
  showSensitiveContent Boolean   @default(false)
  suspendedUntil       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  creator    Creator?
  creatorId  String?  @unique

  posts      Post[]   @relation("AuthorPosts")
  likes      Like[]
  comments   Comment[]

  // Social: following creators via Follow table
  following  Follow[] @relation("UserFollowing")
}

model Creator {
  id            String   @id @default(cuid())
  displayName   String
  bio           String?
  location      String?
  avatarUrl     String?
  coverUrl      String?
  monthlyPrice  Float    @default(0)
  mainCategory  String?
  isVerified    Boolean  @default(false)
  followerCount Int      @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  posts  Post[] @relation("CreatorPosts")
  
  // Back-reference for followers
  followers Follow[] @relation("CreatorFollowers")
}

model Post {
  id            String    @id @default(cuid())
  text          String?
  type          PostType  @default(PUBLIC)
  isNsfw        Boolean   @default(false)
  mediaJson     Json      @default("[]")
  likeCount     Int       @default(0)
  commentCount  Int       @default(0)
  tipCount      Int       @default(0)
  scheduledAt   DateTime?
  timestamp     DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  creator   Creator @relation("CreatorPosts", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String

  author   User   @relation("AuthorPosts", fields: [authorId], references: [id])
  authorId String

  likedBy  Like[]
  comments Comment[]
}

model Like {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  text      String
  createdAt DateTime @default(now())
}

model Follow {
  id           String   @id @default(cuid())
  follower     User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followerId   String
  following    Creator  @relation("CreatorFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  followingId  String
  createdAt    DateTime @default(now())

  @@unique([followerId, followingId])
}

enum UserRole {
  FAN
  CREATOR
  ADMIN
}

enum PostType {
  PUBLIC
  PREMIUM
}
