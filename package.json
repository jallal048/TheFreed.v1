{
  "name": "thefreed",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:push": "prisma db push",
    
    "api:dev": "tsx server/index.ts",
    "api:build": "tsc -p tsconfig.server.json",
    "api:start": "node dist/server/index.js",
    
    "full:dev": "concurrently \"npm run api:dev\" \"npm run dev\"",
    "setup:db": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "setup:env": "cp .env.example .env"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.263.1",
    "date-fns": "^2.30.0",
    
    "@prisma/client": "^6.17.1",
    "prisma": "^6.17.1",
    
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "joi": "^17.11.0",
    "dotenv": "^16.3.1",
    
    "@google/generative-ai": "^0.21.0",
    "stripe": "^14.10.0",
    "nodemailer": "^6.9.7",
    "cloudinary": "^1.41.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^6.4.14",
    
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    
    "tsx": "^4.19.2",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}